# Keep the build context small and the image free of things that must not ship.

# The corpus. Mounted at run time rather than baked in: redistribution rights for the
# underlying ContractNLI, CUAD, MAUD and PrivacyQA documents were never established.
data/

# Local copies of the evaluation files that still contain verbatim contract text,
# produced by scripts/sanitise_evals.py before publication.
*.jsonl.full

# Secrets.
.env

# Caches and models — restored from named volumes, not from the image.
.cache/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Per-run outputs. results/baseline.json is copied explicitly in the Dockerfile
# because the gate needs it; the run directories are history, not input.
results/runs/

.git/
.github/
.idea/
*.md
!README.md